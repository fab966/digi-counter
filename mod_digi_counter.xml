<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="6.0" client="site" method="upgrade">
	<name>Digi Counter</name>
	<author>Fabrizio Galuppi - Digitest</author>
	<creationDate>Mar 2026</creationDate>
	<copyright>Copyright (C) 2026 - 2030 Fabrizio Galuppi - Digitest</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>public2@digitest.net</authorEmail>
	<authorUrl>www.digitest.net</authorUrl>
	<version>2.0.1</version>
	<description>MOD_DIGI_COUNTER_DESC</description>

	<namespace path="src">Digitest\Module\DigiCounter</namespace>

	<files>
		<folder module="mod_digi_counter">src</folder>
		<folder>services</folder>
		<folder>tmpl</folder>
		<folder>assets</folder>
		<folder>fields</folder>
		<filename module="mod_digi_counter">mod_digi_counter.php</filename>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/mod_digi_counter.ini</language>
		<language tag="en-GB">language/en-GB/mod_digi_counter.sys.ini</language>
		<language tag="it-IT">language/it-IT/mod_digi_counter.ini</language>
		<language tag="it-IT">language/it-IT/mod_digi_counter.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field type="note" name="note0" label="MOD_DIGI_COUNTER_SETTINGS_LABEL" />
				<field
					name="title"
					type="text"
					default=""
					label="MOD_DIGI_COUNTER_TITLE_LABEL"
					description="MOD_DIGI_COUNTER_TITLE_DESC"
					filter="safehtml"
				/>
				<field
					name="subtitle"
					type="text"
					default=""
					label="MOD_DIGI_COUNTER_SUBTITLE_LABEL"
					description="MOD_DIGI_COUNTER_SUBTITLE_DESC"
					filter="safehtml"
				/>
				<field
					name="duration"
					type="text"
					default="2000"
					label="MOD_DIGI_COUNTER_DURATION_LABEL"
					description="MOD_DIGI_COUNTER_DURATION_DESC"
				/>
				<field type="spacer" name="line1" hr="true" />
				<field type="note" name="note1" label="MOD_DIGI_COUNTER_COUNTERS_LABEL" />
				<field
					name="element"
					type="subform"
					formsource="/modules/mod_digi_counter/fields/fields.xml"
					multiple="true"
					min="3"
					max="5"
					label="MOD_DIGI_COUNTER_ELEMENTS_LABEL"
					description="MOD_DIGI_COUNTER_ELEMENTS_DESC"
				/>
			</fieldset>

			<fieldset name="CUSTOMISE">
				<field
					name="numColor"
					type="color"
					default="rgba(100, 100, 100, 1)"
					format="rgba"
					label="MOD_DIGI_COUNTER_NUMCOLOR_LABEL"
					description="MOD_DIGI_COUNTER_NUMCOLOR_DESC"
				/>
				<field
					name="numSize"
					type="text"
					default="3rem"
					label="MOD_DIGI_COUNTER_NUMSIZE_LABEL"
					description="MOD_DIGI_COUNTER_NUMSIZE_DESC"
				/>
				<field
					name="labelColor"
					type="color"
					default="rgba(55, 55, 55, 1)"
					format="rgba"
					label="MOD_DIGI_COUNTER_LABELCOLOR_LABEL"
					description="MOD_DIGI_COUNTER_LABELCOLOR_DESC"
				/>
				<field
					name="labelSize"
					type="text"
					default="1rem"
					label="MOD_DIGI_COUNTER_LABELSIZE_LABEL"
					description="MOD_DIGI_COUNTER_LABELSIZE_DESC"
				/>
				<field
					name="titleColor"
					type="color"
					default="rgba(50, 150, 227, 1)"
					format="rgba"
					label="MOD_DIGI_COUNTER_TITLECOLOR_LABEL"
					description="MOD_DIGI_COUNTER_TITLECOLOR_DESC"
				/>
				<field
					name="titleSize"
					type="text"
					default="3rem"
					label="MOD_DIGI_COUNTER_TITLESIZE_LABEL"
					description="MOD_DIGI_COUNTER_TITLESIZE_DESC"
				/>
				<field
					name="subTitleColor"
					type="color"
					default="rgba(22, 138, 132, 1)"
					format="rgba"
					label="MOD_DIGI_COUNTER_SUBTITLECOLOR_LABEL"
					description="MOD_DIGI_COUNTER_SUBTITLECOLOR_DESC"
				/>
				<field
					name="subTitleSize"
					type="text"
					default="2rem"
					label="MOD_DIGI_COUNTER_SUBTITLESIZE_LABEL"
					description="MOD_DIGI_COUNTER_SUBTITLESIZE_DESC"
				/>
				<field
					name="bkgColor"
					type="color"
					default="rgba(220, 220, 220, 1)"
					format="rgba"
					label="MOD_DIGI_COUNTER_BKGCOLOR_LABEL"
					description="MOD_DIGI_COUNTER_BKGCOLOR_DESC"
				/>
				<field
					name="customCSS"
					type="textarea"
					default=""
					label="MOD_DIGI_COUNTER_CUSTOMCSS_LABEL"
					description=""
					rows="10"
					cols="12"
					filter="raw"
				/>
			</fieldset>

			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC"
				/>
				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
					default=""
					rows="3"
				/>
				<field
					name="useintcss"
					type="radio"
					default="1"
					class="btn-group btn-group-yesno"
					label="MOD_DIGI_COUNTER_USEINTCSS_LABEL"
					description="MOD_DIGI_COUNTER_USEINTCSS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="owncache"
					type="list"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC"
					default="1"
					filter="integer">
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
				<field
					name="cache_time"
					type="number"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC"
					default="900"
					filter="integer"
				/>
			</fieldset>
		</fields>
	</config>

	<updateservers>
		<server type="extension" name="mod_digi_counter">https://www.digitest.net/sw/updates/mod_digi_counter.xml</server>
	</updateservers>
</extension>
